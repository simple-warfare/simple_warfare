[decal_ALB图标]
layer: beforeUI
order: 1.5
image:ROOT:数据/贴图/图标/ALB.png
onlyWhileAlive: true
alwaysStartDirAtZero: true
xOffsetAbsolute: ${core.radius}*(-1)-3
yOffsetAbsolute: ${core.radius}*(-1)-4
alpha: 1
imageScale: 0.2
isVisible: if (self.hp<self.maxHp or self.shield<memory.护盾上限 or self.resource.屏障<self.resource.最大屏障 or (self.energy<self.maxEnergy and self.energy>0)) and self.tags(includes="ALB") and not (self.tags(includes="隐藏单位") or self.hasParent)
color: #00FFFF
