color: #007DFF
[decal_衰化条]
@copyFromSection: decal_高温条
color: #7D00FF
order: 1.04
image:ROOT:数据/贴图/图标/生命条反转.png
imageScaleX: min(min(self.resource.衰化/(self.maxHp)*20*${core.radius/10}/52,(self.hp/self.maxHp)*20*${core.radius/10}/52), self.hp/(self.maxHp+memory.护盾上限+self.resource.最大屏障)*20*${core.radius/10}/52)
xOffsetAbsolute: self.hp/(self.maxHp+memory.护盾上限+self.resource.最大屏障)*20*${core.radius/10}+${core.radius}*(-1)+0.5
[decal_衰化死亡]
layer: beforeUI
order: 1.8
onlyWhileAlive: true
alwaysStartDirAtZero: true
xOffsetAbsolute: ${core.radius}*(1)+6
yOffsetAbsolute: (${core.radius}+10.75)*(-0.75)
alpha: 0.9
imageScale: 0.35
isVisible: if self.resource.衰化>self.hp and self.hp>0 and not self.tags(includes="隐藏单位")
image:ROOT:数据/贴图/图标/衰化.png
[decal_衰化死亡模糊]
@copyFromSection: decal_衰化死亡
