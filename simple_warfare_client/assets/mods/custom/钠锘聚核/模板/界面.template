[decal_护盾条_1]
@copyFromSection: decal_绿色生命条
isVisible: if (self.hp<self.maxHp or self.shield<memory.护盾上限 or self.resource.屏障<self.resource.最大屏障 or (self.energy<self.maxEnergy and self.energy>0)) and not (self.tags(includes="隐藏单位") or self.hasParent)
xOffsetAbsolute: self.hp/(self.maxHp+memory.护盾上限+self.resource.最大屏障)*20*${core.radius/10}+${core.radius}*(-1)
imageScaleX: (self.shield-self.resource.屏障)/(self.maxHp+memory.护盾上限+self.resource.最大屏障)*20*${core.radius/10}/52
color: #FFFFFF
order: 0.99
onlyTeam: IGNORE

[decal_屏障条_1]
@copyFromSection: decal_绿色生命条
isVisible: if (self.hp<self.maxHp or self.shield<memory.护盾上限 or self.resource.屏障<self.resource.最大屏障 or (self.energy<self.maxEnergy and self.energy>0)) and not (self.tags(includes="隐藏单位") or self.hasParent)
xOffsetAbsolute: (self.hp+self.shield-self.resource.屏障)/(self.maxHp+memory.护盾上限+self.resource.最大屏障)*20*${core.radius/10}+${core.radius}*(-1)
imageScaleX: (self.resource.屏障)/(self.maxHp+memory.护盾上限+self.resource.最大屏障)*20*${core.radius/10}/52
color: #AAAAAA
order: 1.02
onlyTeam: IGNORE
alpha: 0.9

[decal_生命分割线_1]
layer: beforeUI
image:ROOT:数据/贴图/图标/分割线.png
onlyWhileAlive: true
alwaysStartDirAtZero: true
imageScaleX: 0.5
imageScaleY: 0.8
xOffsetAbsolute:((${layer}*300)/(self.maxHp+memory.护盾上限+self.resource.最大屏障))*(20*${core.radius/10})-${core.radius}
yOffsetAbsolute:${core.radius}*(-1)-3.5
alpha: 1
isVisible: if ((self.maxHp+memory.护盾上限+self.resource.最大屏障)>(${layer}*300)) and (self.hp<self.maxHp or self.shield<memory.护盾上限 or self.resource.屏障<self.resource.最大屏障 or (self.energy<self.maxEnergy and self.energy>0)) and (self.maxHp+memory.护盾上限+self.resource.最大屏障)<3300 and not (self.tags(includes="隐藏单位") or self.hasParent)
order: 1.05
@define layer: 1
color: #000000
dirOffset: 15

