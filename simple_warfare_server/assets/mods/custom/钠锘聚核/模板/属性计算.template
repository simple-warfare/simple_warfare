[hiddenAction_伤害倍率_锁定]
autoTrigger:true
setUnitStats: shootDamageMultiplier=max(memory.伤害倍率,0)
[hiddenAction_伤害倍率_修正]
autoTrigger:if memory.伤害倍率!=max(1+memory.高温减益,0.1)*(1+memory.自身伤害倍率)*(1+memory.阵营伤害倍率)
setUnitMemory: 伤害倍率=max(1+memory.高温减益,0.1)*(1+memory.自身伤害倍率)*(1+memory.阵营伤害倍率)
[hiddenAction_高温倍率_修正]
autoTrigger: if self.resource.高温<=1
setUnitMemory: 高温减益=0

[hiddenAction_移动倍率_锁定]
autoTrigger:true
setUnitStats:moveSpeed=max(memory.移动倍率,0)*${movement.moveSpeed}
[hiddenAction_移动倍率_修正]
autoTrigger:if memory.移动倍率!=max(1+memory.低温减益,0.1)*(1+memory.自身移动倍率)*(1+memory.阵营移动倍率)
setUnitMemory: 移动倍率=max(1+memory.低温减益,0.1)*(1+memory.自身移动倍率)*(1+memory.阵营移动倍率)
[hiddenAction_低温倍率_修正]
autoTrigger: if self.resource.低温<=1
setUnitMemory: 低温减益=0

[hiddenAction_护盾上限_修正]
autoTrigger: if memory.护盾上限!=memory.额外护盾上限+${core.maxShield}
setUnitMemory: 护盾上限=memory.额外护盾上限+${core.maxShield}
[hiddenAction_护盾上限_锁定]
autoTrigger:if self.maxShield!=memory.护盾上限+self.resource.屏障
setUnitStats: maxShield=memory.护盾上限+self.resource.屏障

[hiddenAction_运输槽]
autoTrigger:if memory.运输槽!=${core.transportSlotsNeeded}
setUnitMemory: 运输槽=${core.transportSlotsNeeded}

[hiddenAction_空判定]
autoTrigger: if not self.tags(includes="空") and self.height>=4
temporarilyAddTags: 空
temporarilyRemoveTags: 陆, 潜
[hiddenAction_陆判定]
autoTrigger: if not self.tags(includes="陆") and self.height<4 and self.height>=0
temporarilyAddTags: 陆
temporarilyRemoveTags: 空, 潜
[hiddenAction_潜判定]
autoTrigger: if not self.tags(includes="潜") and self.height<0
temporarilyAddTags: 潜
temporarilyRemoveTags: 空, 陆
